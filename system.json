{
  "id": "palladium-universal",
  "title": "Palladium Universal",
  "description": "A modern Palladium Books Megaverse system with typed Items, DataModel schemas, and tabbed actor sheets.",
  "version": "0.3.0",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "authors": [
    {
      "name": "Jason (simondsjt)",
      "url": "https://github.com/simondsjt/megavault"
    }
  ],
  "esmodules": [
    "module/system.mjs"
  ],
  "styles": [
    "styles/actor-sheet.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "primaryTokenAttribute": "health.hp",
  "secondaryTokenAttribute": "health.sdc",
  "documentTypes": {
    "Actor": {
      "character": {
        "htmlFields": ["biography"]
      }
    },
    "Item": {
      "skill":      {},
      "weapon":     {},
      "armor":      {},
      "spell":      {},
      "psionic":    {},
      "equipment":  {},
      "ammo":       {},
      "cybernetic": {},
      "vehicle":    {},
      "class":      {}
    }
  },
  "grid": {
    "distance": 5,
    "units": "ft"
  },
  "socket": false,
  "packs": [
    {
      "name": "skills",
      "label": "Skills",
      "path": "packs/skills",
      "type": "Item"
    }
  ],
  "url": "https://github.com/simondsjt/megavault"
}
