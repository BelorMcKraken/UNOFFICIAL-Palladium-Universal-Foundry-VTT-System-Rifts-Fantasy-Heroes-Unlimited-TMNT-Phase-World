<section class="tab" data-group="primary" data-tab="skills">
  <section class="panel">
    <div class="panel-header">
      <h2>Skills</h2>
      <span class="item-count">{{skills.length}} skills</span>
    </div>

    {{#if skills.length}}
    <table class="item-list skill-list">
      <thead>
        <tr>
          <th class="skill-name">Skill</th>
          <th class="skill-category">Category</th>
          <th class="skill-proficiency">%</th>
          <th class="skill-source">Source</th>
          <th class="skill-controls">Controls</th>
        </tr>
      </thead>
      <tbody>
        {{#each skills}}
        <tr class="item draggable" data-item-id="{{this._id}}">
          <td class="skill-name">
            <img class="item-img" src="{{this.img}}" width="24" height="24" />
            <span>{{this.name}}</span>
          </td>
          <td class="skill-category">{{this.system.category}}</td>
          <td class="skill-proficiency">{{this.system.currentProficiency}}</td>
          <td class="skill-source">{{this.system.skillSource}}</td>
          <td class="skill-controls">
            <a data-action="editItem" title="Edit"><i class="fas fa-edit"></i></a>
            <a data-action="deleteItem" title="Delete"><i class="fas fa-trash"></i></a>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
    <p class="empty-list">No skills. Drag skills from a compendium or create them manually.</p>
    {{/if}}
  </section>
</section>
